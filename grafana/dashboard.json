      "title": "Fraudes Detectadas",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "format": "table", "rawSql": "SELECT COUNT(*) AS \"fraudes\" FROM transactions WHERE is_fraud AND $__timeFilter(timestamp)", "refId": "A" }]
