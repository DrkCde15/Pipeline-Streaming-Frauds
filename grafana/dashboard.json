      "title": "Valor Total Fraudado",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "format": "table", "rawSql": "SELECT COALESCE(SUM(valor), 0) AS \"valor_fraudado\" FROM transactions WHERE is_fraud AND $__timeFilter(timestamp)", "refId": "A" }]
