      "title": "Alertas por Regra",
      "type": "piechart",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "format": "table", "rawSql": "SELECT r AS \"regra\", COUNT(*) AS \"alertas\" FROM fraud_alerts, LATERAL unnest(regras_ativadas) AS r WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC", "refId": "A" }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
