      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "format": "table", "rawSql": "SELECT COUNT(*) AS \"total\" FROM transactions WHERE $__timeFilter(timestamp)", "refId": "A" }]
