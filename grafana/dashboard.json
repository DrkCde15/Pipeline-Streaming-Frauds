      "title": "Taxa de Fraude",
      "type": "stat",
      "targets": [{ "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "format": "table", "rawSql": "SELECT ROUND(100.0 * SUM(CASE WHEN is_fraud THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0), 3) AS \"taxa_pct\" FROM transactions WHERE $__timeFilter(timestamp)", "refId": "A" }]
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 10000 }] }, "unit": "currencyBRL" }, "overrides": [] },
