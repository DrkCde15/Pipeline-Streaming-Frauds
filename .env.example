# Copie para .env e ajuste: cp .env.example .env
# O compose usa valores com default, então funciona mesmo sem .env.

# Kafka (código usa localhost:9092 por padrão em config/kafka_config.py)
KAFKA_BOOTSTRAP=localhost:9092

# Postgres (usado pelo compose + psql)
POSTGRES_DB=frauddb
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraudpass_change_me
POSTGRES_DSN=postgresql://fraud:fraudpass_change_me@localhost:5432/frauddb

# Grafana (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
